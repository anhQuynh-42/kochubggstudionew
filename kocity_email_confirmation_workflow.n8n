{
  "name": "KOCity - Tự Động Gửi Email Xác Nhận Cho KOC Nhận Mẫu",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kocity-application-registered",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Tiếp Nhận Đơn Mới",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "kocity-application-registered"
    },
    {
      "parameters": {
        "jsCode": "// Chuẩn hóa dữ liệu nhận được từ Website KOCity\nconst body = $input.item.json.body || $input.item.json;\n\nconst rawEmail = body.email || body.kocEmail || body.address || '';\nconst kocName = body.kocName || 'Bạn KOC';\nconst rawHandle = body.tiktokHandle || '';\nconst cleanHandle = rawHandle.startsWith('@') ? rawHandle : (rawHandle ? '@' + rawHandle : 'Chưa cập nhật');\nconst brandName = body.brandName || body.campaignName || 'Nhãn hàng KOCity';\nconst registeredSample = body.registeredSample || body.selectedSampleName || body.sampleProduct || 'Mẫu mặc định';\nconst code = body.code || 'KC-' + Date.now().toString().slice(-6);\nconst nowStr = new Date().toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' });\n\n// Tạo giao diện Email HTML phong cách hiện đại, chuyên nghiệp của KOCity\nconst emailHtml = `\n<!DOCTYPE html>\n<html lang=\"vi\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Xác nhận đăng ký nhận mẫu KOCity</title>\n</head>\n<body style=\"margin: 0; padding: 20px; background-color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1e293b;\">\n  <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 600px; background-color: #ffffff; border-radius: 20px; overflow: hidden; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05); border: 1px solid #e2e8f0;\">\n    <!-- Header Gradient Banner -->\n    <tr>\n      <td style=\"background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #ec4899 100%); padding: 36px 30px; text-align: center;\">\n        <div style=\"display: inline-block; background: rgba(255, 255, 255, 0.2); padding: 6px 16px; border-radius: 999px; margin-bottom: 12px; backdrop-filter: blur(8px);\">\n          <span style=\"color: #ffffff; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;\">🚀 KOCITY CONFIRMATION</span>\n        </div>\n        <h1 style=\"color: #ffffff; margin: 0; font-size: 24px; font-weight: 800; line-height: 1.3;\">ĐĂNG KÝ NHẬN MẪU THÀNH CÔNG</h1>\n        <p style=\"color: rgba(255, 255, 255, 0.9); margin: 8px 0 0 0; font-size: 14px;\">Hồ sơ của bạn đã được chuyển tới nhãn hàng phê duyệt</p>\n      </td>\n    </tr>\n\n    <!-- Nội dung chính -->\n    <tr>\n      <td style=\"padding: 32px 30px;\">\n        <p style=\"font-size: 16px; line-height: 1.6; margin-top: 0;\">\n          Chào <b>${kocName}</b>, chúc mừng bạn đã đăng ký tham gia chiến dịch nhận mẫu trải nghiệm 0đ cùng <b>KOCity</b>!\n        </p>\n        <p style=\"font-size: 14px; line-height: 1.6; color: #475569;\">\n          Dưới đây là thông tin chi tiết về đơn đăng ký của bạn:\n        </p>\n\n        <!-- Card Bảng Thông Tin Chi Tiết -->\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f8fafc; border-radius: 16px; border: 1px solid #e2e8f0; margin: 20px 0; overflow: hidden;\">\n          <tr>\n            <td style=\"padding: 14px 18px; border-bottom: 1px solid #e2e8f0; font-size: 14px; color: #64748b; width: 38%;\">Mã đơn đăng ký:</td>\n            <td style=\"padding: 14px 18px; border-bottom: 1px solid #e2e8f0; font-size: 14px; font-weight: 700; color: #6366f1; font-family: monospace;\">${code}</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 14px 18px; border-bottom: 1px solid #e2e8f0; font-size: 14px; color: #64748b;\">Họ và tên KOC:</td>\n            <td style=\"padding: 14px 18px; border-bottom: 1px solid #e2e8f0; font-size: 14px; font-weight: 600; color: #0f172a;\">${kocName}</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 14px 18px; border-bottom: 1px solid #e2e8f0; font-size: 14px; color: #64748b;\">Kênh TikTok:</td>\n            <td style=\"padding: 14px 18px; border-bottom: 1px solid #e2e8f0; font-size: 14px; font-weight: 600; color: #0f172a;\">${cleanHandle}</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 14px 18px; border-bottom: 1px solid #e2e8f0; font-size: 14px; color: #64748b;\">Nhãn hàng (Brand):</td>\n            <td style=\"padding: 14px 18px; border-bottom: 1px solid #e2e8f0; font-size: 14px; font-weight: 700; color: #0f172a;\">${brandName}</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 14px 18px; border-bottom: 1px solid #e2e8f0; font-size: 14px; color: #64748b;\">Sản phẩm đăng ký:</td>\n            <td style=\"padding: 14px 18px; border-bottom: 1px solid #e2e8f0; font-size: 14px; font-weight: 700; color: #ec4899;\">${registeredSample}</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 14px 18px; font-size: 14px; color: #64748b;\">Thời gian gửi đơn:</td>\n            <td style=\"padding: 14px 18px; font-size: 14px; color: #0f172a;\">${nowStr}</td>\n          </tr>\n        </table>\n\n        <!-- Hướng dẫn tiếp theo -->\n        <div style=\"background-color: #fdf2f8; border-left: 4px solid #ec4899; padding: 14px 16px; border-radius: 8px; margin: 24px 0;\">\n          <h4 style=\"margin: 0 0 6px 0; color: #9d174d; font-size: 14px; font-weight: 700;\">📌 Các bước tiếp theo bạn cần lưu ý:</h4>\n          <ul style=\"margin: 0; padding-left: 18px; font-size: 13px; color: #831843; line-height: 1.5;\">\n            <li>Brand sẽ duyệt đơn của bạn trong vòng <b>24h - 48h</b>.</li>\n            <li>Sau khi duyệt, bạn sẽ nhận được mã vận đơn chuyển phát mẫu miễn phí tận nhà.</li>\n            <li>Vui lòng chuẩn bị kịch bản và đăng tải video TikTok trong vòng <b>5 - 7 ngày</b> sau khi nhận được mẫu.</li>\n          </ul>\n        </div>\n\n        <!-- Nút bấm CTA -->\n        <div style=\"text-align: center; margin: 30px 0 10px 0;\">\n          <a href=\"https://kocity.io.vn/#/my-applications\" style=\"display: inline-block; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 14px; font-size: 14px; font-weight: 700; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);\">👉 Xem Tiến Độ Đơn Của Tôi</a>\n        </div>\n      </td>\n    </tr>\n\n    <!-- Footer -->\n    <tr>\n      <td style=\"background-color: #f8fafc; padding: 24px 30px; text-align: center; border-top: 1px solid #e2e8f0;\">\n        <p style=\"margin: 0; font-size: 12px; color: #94a3b8;\">KOCity — Nền tảng kết nối KOC & Nhãn hàng hàng đầu</p>\n        <p style=\"margin: 6px 0 0 0; font-size: 11px; color: #cbd5e1;\">Email này được gửi tự động khi bạn nộp đơn ứng tuyển tại kocity.io.vn</p>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n`;\n\nreturn {\n  json: {\n    toEmail: rawEmail,\n    kocName,\n    cleanHandle,\n    brandName,\n    registeredSample,\n    code,\n    emailSubject: `🎉 [KOCity] Đăng ký nhận mẫu thành công - ${brandName}`,\n    emailHtml\n  }\n};\n"
      },
      "id": "prepare-email",
      "name": "Chuẩn Bị Nội Dung Email HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.toEmail }}",
        "subject": "={{ $json.emailSubject }}",
        "emailType": "html",
        "message": "={{ $json.emailHtml }}",
        "options": {}
      },
      "id": "gmail-send",
      "name": "Gửi Email Xác Nhận Cho KOC",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Email xác nhận đã được gửi thành công đến KOC!\",\n  \"to\": {{ JSON.stringify($json.toEmail) }},\n  \"code\": {{ JSON.stringify($json.code) }}\n}",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Phản Hồi Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [920, 300]
    }
  ],
  "connections": {
    "Webhook Tiếp Nhận Đơn Mới": {
      "main": [
        [
          {
            "node": "Chuẩn Bị Nội Dung Email HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chuẩn Bị Nội Dung Email HTML": {
      "main": [
        [
          {
            "node": "Gửi Email Xác Nhận Cho KOC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gửi Email Xác Nhận Cho KOC": {
      "main": [
        [
          {
            "node": "Phản Hồi Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}

