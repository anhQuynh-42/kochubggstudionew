{
  "name": "KOCity - Tự Động Gửi Email Xác Nhận Khi KOC Đăng Ký Chiến Dịch Thành Công",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kocity-application-registered",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Tiếp Nhận Đơn KOC Mới",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -260,
        120
      ],
      "webhookId": "kocity-application-registered"
    },
    {
      "parameters": {
        "jsCode": "// Hỗ trợ cả application/json lẫn text/plain (từ fetch mode: no-cors trên trình duyệt)\nconst item = $input.first().json || {};\nlet body = item.body ?? item;\nif (typeof body === 'string') {\n  try {\n    body = JSON.parse(body);\n  } catch {\n    body = {};\n  }\n}\n\nconst rawEmail = String(body.email || body.kocEmail || '').trim();\nif (!rawEmail || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(rawEmail)) {\n  // Bỏ qua nếu không có email hợp lệ để tránh lỗi node Gmail\n  return [];\n}\n\nconst esc = (s) => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;');\n\nconst kocName = String(body.kocName || 'Bạn KOC').trim();\nconst rawHandle = String(body.tiktokHandle || '').trim();\nconst cleanHandle = rawHandle ? (rawHandle.startsWith('@') ? rawHandle : '@' + rawHandle) : 'Chưa cập nhật';\nconst brandName = String(body.brandName || body.campaignName || 'Nhãn hàng KOCity').trim();\nconst campaignName = String(body.campaignName || brandName).trim();\nconst registeredSample = String(body.registeredSample || body.selectedSampleName || body.sampleProduct || 'Mẫu mặc định').trim();\nconst code = String(body.code || '#KOC-' + Date.now().toString().slice(-4)).trim();\nconst nowStr = String(body.submittedAt || new Date().toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' }));\n\nconst emailHtml = `\n<!DOCTYPE html>\n<html lang=\"vi\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Xác nhận đăng ký chiến dịch KOCity</title>\n</head>\n<body style=\"margin:0;padding:20px;background-color:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1e293b;\">\n  <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:600px;background-color:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 10px 25px -5px rgba(0,0,0,0.06);border:1px solid #e2e8f0;\">\n    <tr>\n      <td style=\"background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 50%,#ec4899 100%);padding:34px 28px;text-align:center;\">\n        <div style=\"display:inline-block;background:rgba(255,255,255,0.2);padding:6px 16px;border-radius:999px;margin-bottom:12px;\">\n          <span style=\"color:#ffffff;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;\">KOCITY • XÁC NHẬN ĐĂNG KÝ</span>\n        </div>\n        <h1 style=\"color:#ffffff;margin:0;font-size:23px;font-weight:800;line-height:1.3;\">ĐĂNG KÝ CHIẾN DỊCH THÀNH CÔNG!</h1>\n        <p style=\"color:rgba(255,255,255,0.92);margin:8px 0 0 0;font-size:14px;\">Hồ sơ của bạn đã được chuyển tới nhãn hàng <b>${esc(brandName)}</b> phê duyệt</p>\n      </td>\n    </tr>\n    <tr>\n      <td style=\"padding:30px 28px;\">\n        <p style=\"font-size:15px;line-height:1.6;margin-top:0;\">\n          Chào <b>${esc(kocName)}</b>, cảm ơn bạn đã đăng ký tham gia chiến dịch nhận mẫu 0đ trên <b>KOCity</b>!\n        </p>\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f8fafc;border-radius:16px;border:1px solid #e2e8f0;margin:18px 0;overflow:hidden;\">\n          <tr>\n            <td style=\"padding:12px 16px;border-bottom:1px solid #e2e8f0;font-size:13px;color:#64748b;width:38%;\">Mã đơn đăng ký:</td>\n            <td style=\"padding:12px 16px;border-bottom:1px solid #e2e8f0;font-size:14px;font-weight:700;color:#6366f1;font-family:monospace;\">${esc(code)}</td>\n          </tr>\n          <tr>\n            <td style=\"padding:12px 16px;border-bottom:1px solid #e2e8f0;font-size:13px;color:#64748b;\">Kênh TikTok:</td>\n            <td style=\"padding:12px 16px;border-bottom:1px solid #e2e8f0;font-size:14px;font-weight:600;color:#0f172a;\">${esc(cleanHandle)}</td>\n          </tr>\n          <tr>\n            <td style=\"padding:12px 16px;border-bottom:1px solid #e2e8f0;font-size:13px;color:#64748b;\">Chiến dịch:</td>\n            <td style=\"padding:12px 16px;border-bottom:1px solid #e2e8f0;font-size:14px;font-weight:700;color:#0f172a;\">${esc(campaignName)}</td>\n          </tr>\n          <tr>\n            <td style=\"padding:12px 16px;border-bottom:1px solid #e2e8f0;font-size:13px;color:#64748b;\">Sản phẩm mẫu:</td>\n            <td style=\"padding:12px 16px;border-bottom:1px solid #e2e8f0;font-size:14px;font-weight:700;color:#db2777;\">${esc(registeredSample)}</td>\n          </tr>\n          <tr>\n            <td style=\"padding:12px 16px;font-size:13px;color:#64748b;\">Thời gian gửi:</td>\n            <td style=\"padding:12px 16px;font-size:13px;color:#0f172a;\">${esc(nowStr)}</td>\n          </tr>\n        </table>\n\n        <div style=\"background-color:#fdf2f8;border-left:4px solid #ec4899;padding:14px 16px;border-radius:8px;margin:20px 0;\">\n          <h4 style=\"margin:0 0 6px 0;color:#9d174d;font-size:14px;font-weight:700;\">Các bước tiếp theo:</h4>\n          <ul style=\"margin:0;padding-left:18px;font-size:13px;color:#831843;line-height:1.6;\">\n            <li>Nhãn hàng sẽ xét duyệt hồ sơ kênh trong vòng <b>24h – 48h</b>.</li>\n            <li>Khi được duyệt, KOCity sẽ thông báo ngay trong mục <b>Đơn của tôi</b> và qua Email.</li>\n            <li>Sau khi nhận mẫu 0đ, bạn vui lòng đăng video gắn giỏ hàng trong vòng <b>5 – 7 ngày</b>.</li>\n          </ul>\n        </div>\n\n        <div style=\"text-align:center;margin:26px 0 6px 0;\">\n          <a href=\"https://kocity.io.vn/#/my-applications\" style=\"display:inline-block;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#ffffff;text-decoration:none;padding:13px 28px;border-radius:12px;font-size:14px;font-weight:700;\">Xem Tiến Độ Đơn Của Tôi</a>\n        </div>\n      </td>\n    </tr>\n    <tr>\n      <td style=\"background-color:#f8fafc;padding:20px 28px;text-align:center;border-top:1px solid #e2e8f0;\">\n        <p style=\"margin:0;font-size:12px;color:#94a3b8;\">KOCity — Nền tảng kết nối Nano/Micro KOC & Nhãn hàng (Mẫu 0đ)</p>\n        <p style=\"margin:4px 0 0 0;font-size:11px;color:#cbd5e1;\">Email tự động từ kocity.io.vn • Vui lòng không trả lời email này</p>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n`;\n\nreturn [{\n  json: {\n    toEmail: rawEmail,\n    kocName,\n    cleanHandle,\n    brandName,\n    campaignName,\n    registeredSample,\n    code,\n    emailSubject: `[KOCity] Xác nhận đăng ký chiến dịch ${brandName} thành công (${code})`,\n    emailHtml\n  }\n}];"
      },
      "id": "prepare-email",
      "name": "Chuẩn Bị Nội Dung Email HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        120
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.toEmail }}",
        "subject": "={{ $json.emailSubject }}",
        "emailType": "html",
        "message": "={{ $json.emailHtml }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "gmail-send",
      "name": "Gửi Email Xác Nhận Về Gmail KOC",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        300,
        120
      ]
    }
  ],
  "connections": {
    "Webhook Tiếp Nhận Đơn KOC Mới": {
      "main": [
        [
          {
            "node": "Chuẩn Bị Nội Dung Email HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chuẩn Bị Nội Dung Email HTML": {
      "main": [
        [
          {
            "node": "Gửi Email Xác Nhận Về Gmail KOC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}
