{
  "name": "KOCity - Quét Video Cỏ Mềm Theo Hashtag #comem #ADFI (Apify Free + 68 KOC)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 12,20 * * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Lịch Quét Ngầm (12h & 20h Hàng Ngày)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -520,
        -80
      ]
    },
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Bấm Để Quét Ngay",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -520,
        120
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://docs.google.com/spreadsheets/d/16HWYJ3w8x2k_lLvOnB7OGdtWe2KhAAVmNNG6SNkYuZo/export?format=csv&gid=557155338",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 20000
        }
      },
      "id": "fetch-sheet-csv",
      "name": "Tải Danh Sách 68 KOC Cỏ Mềm (CSV 0đ)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -260,
        20
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse RFC-4180 CSV (hỗ trợ ô có xuống dòng trong Google Sheets)\nconst raw = $input.first().json.data ?? $input.first().json;\nconst text = typeof raw === 'string' ? raw : String(raw || '');\n\nconst rows = [];\nlet cur = [];\nlet field = '';\nlet inQuotes = false;\nfor (let i = 0; i < text.length; i++) {\n  const c = text[i];\n  if (inQuotes) {\n    if (c === '\"' && text[i + 1] === '\"') {\n      field += '\"';\n      i++;\n    } else if (c === '\"') {\n      inQuotes = false;\n    } else {\n      field += c;\n    }\n  } else {\n    if (c === '\"') {\n      inQuotes = true;\n    } else if (c === ',') {\n      cur.push(field);\n      field = '';\n    } else if (c === '\\r') {\n      // bỏ qua CR\n    } else if (c === '\\n') {\n      cur.push(field);\n      rows.push(cur);\n      cur = [];\n      field = '';\n    } else {\n      field += c;\n    }\n  }\n}\nif (field || cur.length) {\n  cur.push(field);\n  rows.push(cur);\n}\n\nif (rows.length < 2) return [];\n\nconst headers = rows[0].map(h => String(h || '').trim().toLowerCase());\nconst idxProduct = headers.findIndex(h => h.includes('sản phẩm') || h.includes('san pham'));\nconst idxId = headers.findIndex(h => h.includes('id name') || (h.includes('tiktok của bạn') && !h.includes('link')));\nconst idxLink = headers.findIndex(h => h.includes('link kênh') || h.includes('link kenh'));\nconst idxFollowers = headers.findIndex(h => h.includes('follower'));\nconst idxApproved = headers.findIndex(h => h.includes('brand duyệt') || h.includes('brand duyet'));\n\nconst colProduct = idxProduct >= 0 ? idxProduct : 0;\nconst colId = idxId >= 0 ? idxId : 1;\nconst colLink = idxLink >= 0 ? idxLink : 2;\nconst colFollowers = idxFollowers >= 0 ? idxFollowers : 3;\nconst colApproved = idxApproved >= 0 ? idxApproved : 4;\n\nconst cleanHandle = (linkVal, idVal) => {\n  const link = String(linkVal || '').trim();\n  const m = link.match(/tiktok\\.com\\/@([a-zA-Z0-9._]+)/i);\n  if (m && m[1]) return m[1].trim();\n  let id = String(idVal || '').trim();\n  id = id.replace(/^https?:\\/\\/(www\\.)?tiktok\\.com\\/@?/i, '').replace(/^@+/, '').split(/[/?\\s]/)[0];\n  return id.trim();\n};\n\nconst kocMap = {};\nfor (let r = 1; r < rows.length; r++) {\n  const row = rows[r];\n  const approved = String(row[colApproved] || '').trim().toUpperCase();\n  if (approved !== 'TRUE') continue;\n\n  const kocHandle = cleanHandle(row[colLink], row[colId]);\n  if (!kocHandle) continue;\n\n  const key = kocHandle.toLowerCase();\n  if (kocMap[key]) continue;\n\n  kocMap[key] = {\n    kocHandle,\n    product: String(row[colProduct] || 'Cỏ Mềm Homelab').trim().replace(/\\s+/g, ' ').slice(0, 80),\n    sheetFollowers: String(row[colFollowers] || '').trim()\n  };\n}\n\nreturn [{\n  json: {\n    totalTarget: Object.keys(kocMap).length,\n    kocMap,\n    hashtags: ['comem', 'comemhomelab', 'adfi', 'kocity'],\n    campaignHashtags: ['#comem', '#comemhomelab', '#adfi', '#kocity', '#myphamthiennhien'],\n    campaignKeywords: ['cỏ mềm', 'comem', 'son dưỡng gạo', 'notes of nature', 'sâm 1700']\n  }\n}];"
      },
      "id": "normalize-koc-map",
      "name": "Chuẩn Hóa Danh Sách 68 KOC Đã Duyệt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        20
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/clockworks~tiktok-scraper/run-sync-get-dataset-items",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "DAN_APIFY_TOKEN_CUA_BAN_VAO_DAY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ hashtags: $json.hashtags, resultsPerPage: 30, shouldDownloadVideos: false, shouldDownloadCovers: false }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "apify-hashtag-scan",
      "name": "Quét Video Theo Hashtag #comem #ADFI (Apify Free)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        20
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Chuẩn Hóa Danh Sách 68 KOC Đã Duyệt').first().json;\nconst kocMap = cfg.kocMap || {};\nconst videos = $input.all().map(i => i.json);\n\nconst staticData = $getWorkflowStaticData('global');\nif (!Array.isArray(staticData.detectedVideoIds)) staticData.detectedVideoIds = [];\nif (!Array.isArray(staticData.postedKocs)) staticData.postedKocs = [];\n\nconst esc = (s) => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst out = [];\n\nfor (const v of videos) {\n  const id = String(v.id || v.webVideoUrl || '').trim();\n  const authorRaw = String(v.authorMeta?.name || '').trim();\n  if (!id || !authorRaw) continue;\n\n  // 1. Chỉ lấy video của ĐÚNG 68 KOC Cỏ Mềm đã được Brand duyệt = TRUE\n  const kocKey = authorRaw.toLowerCase();\n  const kocMeta = kocMap[kocKey];\n  if (!kocMeta) continue;\n\n  // 2. Xác nhận chắc chắn caption/hashtag nói về Cỏ Mềm (loại bỏ 100% brand khác)\n  const caption = String(v.text || '');\n  const lower = caption.toLowerCase();\n  const fromTags = Array.isArray(v.hashtags)\n    ? v.hashtags.map(h => '#' + String(h.name || '').toLowerCase())\n    : [];\n  const matchedTags = (cfg.campaignHashtags || []).filter(t => lower.includes(t) || fromTags.includes(t));\n  const matchedWords = (cfg.campaignKeywords || []).filter(w => lower.includes(w));\n  if (matchedTags.length === 0 && matchedWords.length === 0) continue;\n\n  // 3. Chống báo trùng video cũ\n  if (staticData.detectedVideoIds.includes(id)) continue;\n  staticData.detectedVideoIds.push(id);\n\n  const isNew = !staticData.postedKocs.some(k => k.toLowerCase() === kocKey);\n  if (isNew) staticData.postedKocs.push(kocMeta.kocHandle);\n\n  const posted = staticData.postedKocs.length;\n  const total = cfg.totalTarget || posted;\n  const percent = total ? Math.round((posted / total) * 100) : 0;\n  const when = v.createTimeISO\n    ? new Date(v.createTimeISO).toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' })\n    : 'không rõ';\n  const views = typeof v.playCount === 'number' ? v.playCount.toLocaleString('vi-VN') : 'mới đăng';\n  const videoUrl = v.webVideoUrl || `https://www.tiktok.com/@${kocMeta.kocHandle}/video/${id}`;\n\n  const msg =\n    '🎬 <b>[KOCITY] KOC VỪA LÊN VIDEO CỎ MỀM!</b>\\n\\n' +\n    '👤 <b>KOC:</b> <code>@' + esc(kocMeta.kocHandle) + '</code> ' + (isNew ? '✨ <b>[LẦN ĐẦU LÊN BÀI]</b>' : '🎬 <i>(đăng thêm video)</i>') + '\\n' +\n    '📦 <b>Sản phẩm nhận mẫu:</b> ' + esc(kocMeta.product) + '\\n' +\n    '🔗 <b>Video:</b> <a href=\"' + esc(videoUrl) + '\">' + esc(videoUrl) + '</a>\\n' +\n    '📝 <b>Caption:</b> <i>' + esc(caption.slice(0, 220)) + '</i>\\n' +\n    '👁️ <b>Lượt xem:</b> ' + views + ' • ⏰ ' + when + '\\n' +\n    '🏷️ <b>Khớp:</b> ' + esc(matchedTags.concat(matchedWords).join(' ')) + '\\n\\n' +\n    '━━━━━━━━━━━━━━━━━━━━\\n' +\n    '📊 <b>Tiến độ lên bài Cỏ Mềm:</b> <b>' + posted + '/' + total + ' KOC</b> (' + percent + '%)\\n' +\n    '⏳ <b>Chưa lên bài:</b> ' + Math.max(0, total - posted) + ' KOC\\n' +\n    '━━━━━━━━━━━━━━━━━━━━';\n\n  out.push({\n    json: {\n      koc: kocMeta.kocHandle,\n      product: kocMeta.product,\n      videoUrl,\n      telegramMessage: msg\n    }\n  });\n}\n\nreturn out;"
      },
      "id": "filter-comem-videos",
      "name": "Đối Chiếu Đúng 68 KOC Cỏ Mềm & Lọc Trùng",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        20
      ]
    },
    {
      "parameters": {
        "chatId": "-5348405193",
        "text": "={{ $json.telegramMessage }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "telegram-alert",
      "name": "Bắn Báo Cáo Về Telegram Admin",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        780,
        20
      ],
      "credentials": {
        "telegramApi": {
          "id": "plkCDjWQ4FVlZDxe",
          "name": "Telegram account"
        }
      }
    }
  ],
