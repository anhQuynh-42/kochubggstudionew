    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "koc-sample-claim",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-get-beacon",
      "name": "Webhook Nhận Tín Hiệu Ngầm (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -220,
        180
      ],
      "webhookId": "koc-sample-claim-get"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json || {};\nconst query = (item.query && Object.keys(item.query).length > 0) ? item.query : (item.body || {});\n\n// Danh sách 8 KOC đã điền/bấm trước đó được nạp sẵn vào hệ thống (đã tự động lọc trùng @yyuunnii03)\nconst PREFILLED_KOCS = [\n  'embes.bii',\n  'dh.t172',\n  'muoi2021.pe',\n  'sunnynguyen09',\n  'Oanh.thu1408',\n  'yyuunnii03',\n  'yenlamme',\n  'gaoiu2511'\n];\n\n// Bộ nhớ tĩnh lưu trữ xuyên suốt các lần chạy của Workflow (n8n global static data)\nconst staticData = $getWorkflowStaticData('global');\nif (!Array.isArray(staticData.claimedKocs) || staticData.claimedKocs.length === 0) {\n  staticData.claimedKocs = [...PREFILLED_KOCS];\n} else {\n  // Đảm bảo các KOC khởi tạo luôn có mặt và không trùng lặp\n  PREFILLED_KOCS.forEach(pre => {\n    if (!staticData.claimedKocs.some(k => k.toLowerCase() === pre.toLowerCase())) {\n      staticData.claimedKocs.push(pre);\n    }\n  });\n}\n\n// Hỗ trợ reset về danh sách 8 KOC khởi tạo: gửi link kèm ?reset=true\nif (query.reset === 'true' || query.action === 'reset') {\n  staticData.claimedKocs = [...PREFILLED_KOCS];\n}\n\n// Làm sạch tên/ID TikTok của KOC (tự động loại bỏ link https://, @www..., dấu @)\nlet rawKoc = (query.koc || 'Ẩn danh').trim();\nrawKoc = rawKoc\n  .replace(/^https?:\\/\\/(www\\.)?tiktok\\.com\\/@?/i, '')\n  .replace(/^@*www\\.tiktok\\.com\\/@?/i, '')\n  .replace(/^@+/, '')\n  .trim();\n\nconst koc = rawKoc || 'Ẩn danh';\nconst product = query.product || 'Sản phẩm Cỏ Mềm';\nconst followers = query.followers || 'Chưa rõ';\nconst affLink = query.affLink || 'https://www.tiktok.com';\nconst now = new Date().toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' });\n\n// Kiểm tra KOC đã từng bấm trước đó chưa (so sánh không phân biệt hoa thường)\nconst kocLower = koc.toLowerCase();\nconst isExisting = staticData.claimedKocs.some(name => name.toLowerCase() === kocLower);\nconst isValidKoc = koc && koc !== 'Ẩn danh';\n\nif (!isExisting && isValidKoc) {\n  staticData.claimedKocs.push(koc);\n}\n\nconst totalUnique = staticData.claimedKocs.length;\nconst totalTarget = 68;\nconst percent = Math.round((totalUnique / totalTarget) * 100);\n\n// Tạo danh sách KOC đã bấm dạng hiển thị không trùng lặp\nlet kocListText = '';\nif (totalUnique === 0) {\n  kocListText = '<i>(Chưa có KOC nào)</i>';\n} else if (totalUnique <= 25) {\n  kocListText = staticData.claimedKocs.map((name, idx) => `${idx + 1}. <code>@${name}</code>`).join('\\n');\n} else {\n  kocListText = staticData.claimedKocs.map(name => `<code>@${name}</code>`).join(' • ');\n}\n\nconst statusTag = isExisting \n  ? '🔄 <i>(KOC này đã từng bấm trước đó)</i>' \n  : '✨ <b>[KOC MỚI BẤM LẦN ĐẦU]</b>';\n\nconst telegramMessage = \n  `🎉 <b>[KOCITY] KOC VỪA BẤM YÊU CẦU MẪU CỎ MỀM!</b>\\n\\n` +\n  `👤 <b>KOC:</b> <code>@${koc}</code> ${statusTag}\\n` +\n  `📦 <b>Sản phẩm:</b> <b>${product}</b>\\n` +\n  `👥 <b>Followers:</b> ${followers}\\n` +\n  `⏰ <b>Thời gian:</b> ${now}\\n\\n` +\n  `🔗 <b>Kênh TikTok:</b> https://www.tiktok.com/@${koc}\\n` +\n  `🎁 <b>Link mẫu đã bấm:</b> <a href=\"${affLink}\">Mở TikTok Affiliate</a>\\n\\n` +\n  `━━━━━━━━━━━━━━━━━━━━\\n` +\n  `📊 <b>TỔNG KẾT KOC ĐÃ BẤM NHẬN MẪU:</b>\\n` +\n  `🔥 <b>Tiến độ:</b> <b>${totalUnique}/${totalTarget} KOC</b> (${percent}%)\\n` +\n  `👥 <b>Tổng số KOC độc nhất:</b> <b>${totalUnique} KOC</b>\\n` +\n  `📋 <b>Danh sách KOC không trùng:</b>\\n${kocListText}\\n` +\n  `━━━━━━━━━━━━━━━━━━━━\\n\\n` +\n  `💡 <i>Nhắc nhở: Hãy vào TikTok Shop Seller Center kiểm tra và duyệt gửi mẫu cho KOC nhé!</i>`;\n\nreturn [{\n  json: {\n    koc,\n    product,\n    followers,\n    affLink,\n    now,\n    isFirstTime: !isExisting,\n    totalUnique,\n    totalTarget,\n    percent,\n    uniqueKocs: staticData.claimedKocs,\n    telegramMessage\n  }\n}];"
      },
      "id": "format-data",
      "name": "Xử Lý Thông Tin KOC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        90
      ]
    },
    {
      "parameters": {
        "chatId": "-5348405193",
        "text": "={{ $json.telegramMessage }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "telegram-notify",
      "name": "Bắn Thông Báo Về Telegram Admin",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        360,
        90
      ],
      "credentials": {
        "telegramApi": {
          "id": "8YlUcAebdBbqEpKr",
          "name": "Telegram account"
        }
      }
    }
  ],
